# Copier vers .env — ne jamais committer de vraies valeurs.
# Absent ou YOUR_* = non configuré. L'app reste locale, sans appel au démarrage.
# EXPO_PUBLIC_EXAMPLE_ENV_VAR a été supprimée : ne pas la réintroduire.

EXPO_PUBLIC_BACKEND_URL=YOUR_BACKEND_URL
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Obsolètes tant qu'aucun backend n'existe dans ce dépôt.
# Conservées pour mémoire, jamais lues par l'application.
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET
DATABASE_URL=YOUR_DATABASE_URL

# Phase ultérieure, côté serveur uniquement (jamais dans le bundle).
WIX_SITE_ID=YOUR_WIX_SITE_ID
WIX_SITE_URL=YOUR_WIX_SITE_URL
# YOUR_EMAIL_PROVIDER_KEY

# Saisis dans Réglages, pas ici : YOUR_SWISS_IBAN, YOUR_VAT_NUMBER, YOUR_LOGO_GREEN, YOUR_SUPPORT_EMAIL
