# Copier vers .env — ne jamais committer de vraies valeurs.
# Côté client (lu par l'app). Absent / YOUR_* => mode local hors ligne.
EXPO_PUBLIC_BACKEND_URL=YOUR_BACKEND_URL

# Côté serveur UNIQUEMENT (backend optionnel, jamais dans le bundle de l'app)
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET
DATABASE_URL=YOUR_DATABASE_URL
WIX_SITE_ID=YOUR_WIX_SITE_ID
WIX_SITE_URL=YOUR_WIX_SITE_URL
