# Copier vers .env — ne jamais committer de vraies valeurs.
# Côté client (lu par l'app). Absent / YOUR_* => mode local hors ligne.
EXPO_PUBLIC_BACKEND_URL=YOUR_BACKEND_URL

# Journal de crash. Absent ou YOUR_* = désactivé, aucun appel réseau.
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN

# Lien support (non branché dans cette passe). Ne pas inventer d'adresse.
EXPO_PUBLIC_SUPPORT_EMAIL=YOUR_SUPPORT_EMAIL

# Côté serveur UNIQUEMENT (backend optionnel, jamais dans le bundle de l'app).
# Conservés car documentés en v1 ; le backend Vibecode n'est pas appelé au démarrage.
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET
DATABASE_URL=YOUR_DATABASE_URL
WIX_SITE_ID=YOUR_WIX_SITE_ID
WIX_SITE_URL=YOUR_WIX_SITE_URL

# Ne pas réintroduire EXPO_PUBLIC_EXAMPLE_ENV_VAR.
# IBAN, n° TVA et logo se saisissent dans Réglages (YOUR_SWISS_IBAN, YOUR_VAT_NUMBER, YOUR_LOGO_GREEN).
# Ne pas y mettre de vraie valeur dans ce fichier.
