{
  "tools": [
    {
      "type": "function",
      "name": "create_lead",
      "description": "Crée un établissement prospect B2B (et la personne associée) quand l'appelant n'est pas déjà dans le contexte. Ne pas appeler si un client_id est déjà fourni. Source forcée : telephonie_ia.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "company_name": { "type": "string", "description": "Nom de l'établissement." },
          "phone_e164": { "type": "string", "description": "Téléphone en E.164, ex. +41211234567." },
          "city": { "type": "string" },
          "canton": { "type": "string", "description": "Code canton sur deux lettres, ex. VD." },
          "sector": { "type": "string", "description": "restaurant, cafe, hotel, epicerie, commerce, autre." },
          "contact_name": { "type": "string" },
          "contact_role": { "type": "string" },
          "email": { "type": "string" },
          "language": { "type": "string", "enum": ["fr", "en", "ar", "de"] },
          "business_unit": { "type": "string", "enum": ["drinks", "home_made"] },
          "notes": { "type": "string" }
        },
        "required": ["company_name", "phone_e164"]
      }
    },
    {
      "type": "function",
      "name": "update_contact",
      "description": "Met à jour uniquement les champs autorisés : rôle, e-mail, décideur, langue, qualification (besoin, volume, décideur), étape, meilleure plage horaire. Refuse tout autre champ.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_id": { "type": "string" },
          "contact_id": { "type": "string" },
          "role": { "type": "string" },
          "email": { "type": "string" },
          "is_decision_maker": { "type": "boolean" },
          "language": { "type": "string", "enum": ["fr", "en", "ar", "de"] },
          "preferred_language": { "type": "string", "enum": ["fr", "en", "ar", "de"] },
          "stage": {
            "type": "string",
            "enum": ["prospect", "contacte", "rdv_echantillon", "essai", "premiere_commande", "client_actif"]
          },
          "best_call_hours": { "type": "string" },
          "qualification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "besoin": { "type": "string" },
              "volume": { "type": "string" },
              "decideur": { "type": "string" }
            }
          }
        },
        "required": []
      }
    },
    {
      "type": "function",
      "name": "lookup_knowledge_base",
      "description": "Lit les articles publiés et les produits. Seule source autorisée pour un prix ou un fait produit. Ne jamais inventer si le résultat est vide.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["produits", "tarifs", "horaires", "livraison", "partenariats", "sav", "faq"]
          },
          "language": { "type": "string", "enum": ["fr", "en", "ar", "de"] }
        },
        "required": ["query"]
      }
    },
    {
      "type": "function",
      "name": "check_availability",
      "description": "Propose des créneaux ouvrés (lun–ven, plages d'appel, hors fériés Vaud et fédéraux) pour un rendez-vous.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "description": "AAAA-MM-JJ, fuseau Europe/Zurich." },
          "duration_minutes": { "type": "integer", "minimum": 15, "maximum": 180 },
          "kind": { "type": "string", "enum": ["degustation", "visite", "appel", "livraison_echantillon"] }
        },
        "required": ["date"]
      }
    },
    {
      "type": "function",
      "name": "book_meeting",
      "description": "Crée le rendez-vous seulement après un oui oral explicite. confirmed_orally doit être true. Créneau ouvré uniquement.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "starts_at": { "type": "string", "description": "ISO 8601." },
          "ends_at": { "type": "string", "description": "ISO 8601, après starts_at." },
          "kind": { "type": "string", "enum": ["degustation", "visite", "appel", "livraison_echantillon"] },
          "location": { "type": "string" },
          "confirmed_orally": { "type": "boolean" },
          "notes": { "type": "string" },
          "client_id": { "type": "string" },
          "contact_id": { "type": "string" }
        },
        "required": ["title", "starts_at", "ends_at", "confirmed_orally"]
      }
    },
    {
      "type": "function",
      "name": "transfer_call",
      "description": "Demande un transfert à chaud vers le portable du responsable. Une seule tentative. Hors plage, l'outil prend un rappel au lieu de transférer.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": { "type": "string" },
          "urgency": { "type": "string", "enum": ["normale", "haute"] },
          "whisper": { "type": "string", "description": "Une phrase, entendue seulement par le responsable." }
        },
        "required": ["reason", "whisper"]
      }
    },
    {
      "type": "function",
      "name": "add_to_dnc",
      "description": "Ajoute le numéro à la liste ne-plus-appeler, immédiatement, sur tout refus de sollicitation. Irréversible pour l'assistante.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "phone_e164": { "type": "string" },
          "reason": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["demande_orale", "annuaire_asterisque", "non_inscrit_annuaire", "manuel", "email", "droit_opposition_nlpd", "import"]
          }
        },
        "required": ["reason"]
      }
    },
    {
      "type": "function",
      "name": "log_call_summary",
      "description": "À appeler avant de raccrocher. Enregistre résultat, sentiment, résumé et suite. Ne pas inventer un rendez-vous qui n'a pas été confirmé par book_meeting.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "type": "string",
            "enum": ["interesse", "a_rappeler", "refus", "ne_plus_appeler", "rdv_pris", "echantillon", "catalogue", "transfere", "message_laisse", "info_donnee", "commande", "sav", "autre"]
          },
          "sentiment": {
            "type": "string",
            "enum": ["tres_negatif", "negatif", "neutre", "positif", "tres_positif"]
          },
          "summary": { "type": "string" },
          "next_steps": { "type": "string" },
          "lead_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "qualification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "besoin": { "type": "string" },
              "volume": { "type": "string" },
              "decideur": { "type": "string" }
            }
          }
        },
        "required": ["outcome", "summary"]
      }
    }
  ]
}
