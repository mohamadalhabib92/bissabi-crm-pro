# Copier vers services/voice-gateway/.env — ne jamais committer de vraies valeurs.
# Le bac à sable est actif par défaut : seuls les numéros de SANDBOX_ALLOWLIST peuvent être appelés.

PORT=8080
PUBLIC_GATEWAY_URL=YOUR_PUBLIC_GATEWAY_URL
SANDBOX_MODE=true
SANDBOX_ALLOWLIST=YOUR_OWNER_MOBILE_E164
TRANSFER_PHONE_NUMBER=YOUR_OWNER_MOBILE_E164
BISSABI_OWNER_ID=YOUR_SUPABASE_USER_UUID
OWNER_DISPLAY_NAME=le responsable Bissabi

SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

TELEPHONY_PROVIDER=telnyx
TELNYX_API_KEY=YOUR_TELNYX_API_KEY
TELNYX_PUBLIC_KEY=YOUR_TELNYX_PUBLIC_KEY
TELNYX_CONNECTION_ID=YOUR_TELNYX_CONNECTION_ID
TELNYX_FROM_NUMBER=YOUR_TELNYX_FROM_E164

# Adaptateur secondaire. Laisser vide tant que Telnyx est le fournisseur actif.
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=YOUR_TWILIO_FROM_E164

VOICE_PROVIDER=grok
XAI_API_KEY=YOUR_XAI_API_KEY
XAI_VOICE_MODEL=grok-voice-latest

# Plan B UE : tant que ces trois URL ne sont pas posées, l'adaptateur refuse d'ouvrir une session.
EU_STT_URL=
EU_LLM_URL=
EU_TTS_URL=

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN
GOOGLE_CALENDAR_ID=YOUR_GOOGLE_CALENDAR_ID
OUTLOOK_ACCESS_TOKEN=

RECORDING_ENABLED=false
DIALER_INTERVAL_MS=20000
PROMPTS_DIR=
